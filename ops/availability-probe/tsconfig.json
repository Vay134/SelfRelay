{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "WebWorker"],
        "allowJs": false,
        "skipLibCheck": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "types": ["@cloudflare/workers-types", "vitest/globals"]
    },
    "include": ["src", "tests"]
}
