# Development-only values. Use a local environment file for real credentials.
APP_ENV=development
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:8000
DATABASE_URL=postgresql://localhost:5432/e2e_secure_file_transfer
LOG_LEVEL=INFO
AUTH_ADAPTER=fake
TURN_ADAPTER=fake
RATE_LIMIT_SECRET=development-only-replace-this-value
# Required when TURN_ADAPTER=cloudflare; keep both values server-side.
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=

# Planned production configuration for Cloud Run / Google Secret Manager.
# Leave this block commented for local development; it does not override the defaults above.
# APP_ENV=production
# APP_ORIGIN=  # set to https://<pages-project>.pages.dev
# API_ORIGIN=  # set to https://<cloud-run-service>.<region>.run.app
# AUTH_ADAPTER=supabase
# TURN_ADAPTER=disabled
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# RATE_LIMIT_SECRET=
# AVAILABILITY_PROBE_TOKEN=
#
# Brevo SMTP credentials belong only in Supabase Auth custom SMTP configuration.
# Do not add SMTP credentials to Cloud Run, Pages, the frontend, or this repository.
